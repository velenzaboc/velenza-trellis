{
  "_comment": "Post-cutover task-graph config. Use this only after migrations/001_fleet_plan_project_namespace.sql has been applied, counts verified, and the project-keyed replacement tables have been cut over to the production Tasks/TaskLinks/TaskDeps names. The default task-graph.config.json deliberately omits project_column so a source merge + rebuild remains compatible with the current live schema before cutover. Its task_statuses absorbs lists hold only their own member names, matching task-graph.config.json after the 2026-09-14 MVP-GRAPH-STATUS-NORMALIZATION census reached zero non-canonical statuses (worklink LNK-b5ea4bd0).",
  "mode": "experimental_bootstrap",
  "google_credentials": {
    "credentials_source": "application_default",
    "credentials_profile": "impersonated_service_account",
    "credentials_identity": "task-graph-local@example-project.iam.gserviceaccount.com"
  },
  "experimental_admitter": "EXPERIMENTAL_BOOTSTRAP",
  "experimental_query_enabled": true,
  "default_organization_id": "example-org",
  "default_project_id": "arbor",
  "init_database_allowlist": [
    "task-graph"
  ],
  "listen_address": "127.0.0.1:8790",
  "embedding": {
    "provider": "vertex_ai",
    "project": "example-project",
    "location": "us-central1",
    "model": "gemini-embedding-2-preview",
    "dimensions": 3072,
    "max_text_bytes": 32768
  },
  "dedup_policy": {
    "embedding_similarity_threshold": 0.08,
    "candidate_limit": 5,
    "skip_kinds": []
  },
  "pipeline": {
    "_comment": "Consumed ONLY by bootstrap/cmd/spec-lint (the OOD R3-R15 gate). The main task-graph daemon ignores this section (json.Unmarshal drops unknown keys). R6 no-prose is Flash-backed; every flash field is REQUIRED (spec-lint fails-closed without it).",
    "flash": {
      "provider": "vertex_ai",
      "project": "example-project",
      "location": "us-central1",
      "model": "gemini-2.5-flash",
      "max_output_tokens": 256,
      "temperature": 0,
      "prompts": {
        "r6_prose_check_path": "./bootstrap/prompts/r6_prose_check.txt"
      }
    }
  },
  "substrates": [
    {
      "id": "task_graph_iter1",
      "description": "Fleet task-tracking graph — live task-plan Tasks/TaskLinks/TaskDeps store",
      "spanner_database": "projects/example-project/instances/example-instance/databases/task-plan",
      "read_only": false,
      "task_store_type": "fleet_plan_native",
      "project_column": "project_id",
      "task_table": "Tasks",
      "worklink_table": "TaskLinks",
      "dep_table": "TaskDeps"
    }
  ],
  "node_kinds": [
    {
      "name": "task",
      "substrate_id": "task_graph_iter1",
      "artifact_type": "task",
      "version_scope": "stable_id_preserved",
      "what_it_represents": "one fleet plan-to-done unit of work at any tree level (goal, pillar, critical_path, milestone, work_task, gap, or worker_thread), addressed by its snake_case canonical_name",
      "required_contract_fields": [
        "canonical_name",
        "task_ref",
        "level"
      ],
      "required_payload_fields": [
        "status",
        "pillar"
      ]
    },
    {
      "name": "artifact",
      "substrate_id": "task_graph_iter1",
      "artifact_type": "artifact",
      "version_scope": "stable_id_preserved",
      "what_it_represents": "one work artifact (pr, circuit, spec, dispatch, finding, commit, binding) that advanced a task, addressed by its snake_case canonical_name",
      "required_contract_fields": [
        "canonical_name",
        "artifact_type_kind",
        "artifact_ref"
      ],
      "required_payload_fields": []
    }
  ],
  "edge_labels": [
    {
      "name": "advances",
      "source_kinds": [
        "artifact"
      ],
      "target_kinds": [
        "task"
      ],
      "edge_family": "impl",
      "forbid_self_loops": true,
      "direction": "artifact_to_task",
      "meaning": "the artifact advanced the task"
    },
    {
      "name": "owned_by",
      "source_kinds": [
        "task"
      ],
      "target_kinds": [
        "task"
      ],
      "edge_family": "ref",
      "forbid_self_loops": true,
      "direction": "task_to_thread_task",
      "meaning": "the task is owned by the worker-thread task"
    },
    {
      "name": "parent_of",
      "source_kinds": [
        "task"
      ],
      "target_kinds": [
        "task"
      ],
      "reciprocal_label": "child_of",
      "edge_family": "struct",
      "forbid_self_loops": true,
      "direction": "parent_to_child",
      "meaning": "the parent task contains the child task in the plan tree"
    },
    {
      "name": "child_of",
      "source_kinds": [
        "task"
      ],
      "target_kinds": [
        "task"
      ],
      "reciprocal_label": "parent_of",
      "edge_family": "struct",
      "forbid_self_loops": true,
      "direction": "child_to_parent",
      "meaning": "the child task belongs to the parent task in the plan tree"
    },
    {
      "name": "gates",
      "source_kinds": [
        "task"
      ],
      "target_kinds": [
        "task"
      ],
      "reciprocal_label": "gated_by",
      "edge_family": "dep",
      "forbid_self_loops": true,
      "direction": "blocker_to_blocked",
      "meaning": "the source task gates (blocks) the target task"
    },
    {
      "name": "gated_by",
      "source_kinds": [
        "task"
      ],
      "target_kinds": [
        "task"
      ],
      "reciprocal_label": "gates",
      "edge_family": "dep",
      "forbid_self_loops": true,
      "direction": "blocked_to_blocker",
      "meaning": "the source task is gated by (blocked on) the target task"
    }
  ],
  "task_statuses": [
    {
      "name": "not_started",
      "terminal": false,
      "legal_next": [
        "in_progress",
        "blocked",
        "in_review",
        "done",
        "cancelled",
        "archived"
      ],
